{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": { "maxDuration": 30 }
      },
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "AEGIS_FRONTEND_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev:services",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/login",
      "destination": { "service": "app" }
    },
    {
      "source": "/logout",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ],
  "daemons": {
    "aegis-worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "instances": {
        "fra1": 1
      },
      "terminationGracePeriodSeconds": 30
    }
  }
}
